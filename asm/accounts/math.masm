use miden::core::math::u64
use miden::core::math::u128
use miden::core::sys

const ERR_UNDERFLOW = "Underflow"
const ERR_OVERFLOW = "Overflow"


const U32_MAX = 4294967295
const FELT_MAX = 0xFFFFFFFF00000000
const U32_BOUND = 0x100000000


########## math 
@locals(4)
pub proc sqrt_u32(n: u32) -> u32    # floor(sqrt(n)) via bit-by-bit construction.
    # loc.0: n  loc.1: result loc.2: bit loc.3: tmp
    loc_store.0  # save n
    push.0 loc_store.1 # result starts as 0
    push.0x40000000 loc_store.2 # bit starts as 1<<30
    push.0 loc_store.3 # tmp starts as 0

    repeat.16
        loc_load.1 loc_load.2 u32wrapping_add loc_store.3 # tmp = result + bit

        loc_load.0 loc_load.3 u32gte # if n >= tmp
        if.true
            loc_load.0 loc_load.3 u32wrapping_sub loc_store.0 # n = n - tmp
            loc_load.1 u32shr.1 loc_load.2 u32wrapping_add loc_store.1 # result = (result >> 1) + bit
        else
            loc_load.1 u32shr.1 loc_store.1 # result = result >> 1
        end
        loc_load.2 u32shr.2 loc_store.2 # bit = bit >> 2
    end

    loc_load.1
    exec.sys::truncate_stack
end

#! Inputs: [felt]
#! Outputs: [a0, a1, a2, a3] with a0 the least-significant limb.
pub proc felt_to_u128(n: felt) -> u128
    # => [felt]
    push.0.0
    # => [0, 0, felt]
    movup.2
    # => [felt, 0, 0]
    u32split
    # => [lo, hi, 0, 0]
end

#! Cast a u128 into a felt. Panics if the high 64 bits are set,
#! or if the low 64 bits are not a valid field element.
const CAST_LO = 0
const CAST_HI = 1
const CAST_SCALED = 2
const CAST_RES = 3
@locals(4)
pub proc safe_cast_u128_into_felt(a: u128) -> felt
    # => [a0, a1, a2, a3]
    loc_store.CAST_LO loc_store.CAST_HI
    # => [a2, a3]
    eq.0 assert.err=ERR_OVERFLOW
    eq.0 assert.err=ERR_OVERFLOW
    # => []
    loc_load.CAST_HI
    # => [a_hi]
    mul.U32_BOUND dup loc_store.CAST_SCALED
    # => [hi_scaled]
    loc_load.CAST_HI gte assert.err=ERR_OVERFLOW
    # => []
    loc_load.CAST_LO
    # => [a_lo]
    loc_load.CAST_SCALED
    # => [hi_scaled, a_lo]
    add dup loc_store.CAST_RES
    # => [res]
    loc_load.CAST_SCALED gte assert.err=ERR_OVERFLOW
    # => []
    loc_load.CAST_RES
    # => [felt]
end

#! (a * b) / divisor. The product must fit in a u128 and the quotient in a felt.
const MD_DIVISOR = 0
const MD_B = 1
const MD_A = 2
@locals(3)
pub proc mul_div(divisor: felt, b: felt, a: felt) -> felt
    # => [divisor, b, a]
    loc_store.MD_DIVISOR
    # => [b, a]
    loc_store.MD_B
    # => [a]
    loc_store.MD_A
    # => []
    loc_load.MD_A exec.felt_to_u128
    # => [a_u128]
    loc_load.MD_B exec.felt_to_u128
    # => [b_u128, a_u128]
    exec.u128::overflowing_mul
    # => [overflow, product]
    eq.0 assert.err=ERR_OVERFLOW
    # => [product]
    loc_load.MD_DIVISOR exec.felt_to_u128
    # => [divisor, product]
    exec.u128::div
    # => [quotient]
    exec.safe_cast_u128_into_felt
    # => [felt]
    exec.sys::truncate_stack
end

#! Floor square root of a u128. The result always fits in a felt.
const SQ_N = 0
const SQ_RES = 4
const SQ_BIT = 8
const SQ_TMP = 12
const SQ_LEFT = 16
@locals(17)
pub proc sqrt_u128(n: u128) -> felt
    # => [n0, n1, n2, n3]
    loc_storew_le.SQ_N dropw
    # => []
    padw loc_storew_le.SQ_RES dropw
    # bit starts at 1 << 126. Last push is the top limb, so limb0 is 0.
    push.0x40000000.0.0.0
    # => [0, 0, 0, 0x40000000]
    loc_storew_le.SQ_BIT dropw
    # => []
    push.64 loc_store.SQ_LEFT
    push.1
    # => [1]
    while.true
        # tmp = result + bit
        padw loc_loadw_le.SQ_BIT
        padw loc_loadw_le.SQ_RES
        # => [result, bit]
        exec.u128::wrapping_add
        # => [tmp]
        loc_storew_le.SQ_TMP dropw
        # => []
        # n >= tmp
        padw loc_loadw_le.SQ_N
        padw loc_loadw_le.SQ_TMP
        # => [tmp, n]
        exec.u128::gte
        # => [n_ge_tmp]
        if.true
            padw loc_loadw_le.SQ_N
            padw loc_loadw_le.SQ_TMP
            # => [tmp, n]
            exec.u128::wrapping_sub
            # => [n - tmp]
            loc_storew_le.SQ_N dropw
            # result = (result >> 1) + bit
            padw loc_loadw_le.SQ_RES
            push.1
            # => [1, result]
            exec.u128::shr
            # => [result >> 1]
            padw loc_loadw_le.SQ_BIT
            # => [bit, result >> 1]
            exec.u128::wrapping_add
            loc_storew_le.SQ_RES dropw
        else
            padw loc_loadw_le.SQ_RES
            push.1
            exec.u128::shr
            loc_storew_le.SQ_RES dropw
        end
        # bit = bit >> 2
        padw loc_loadw_le.SQ_BIT
        push.2
        exec.u128::shr
        loc_storew_le.SQ_BIT dropw
        loc_load.SQ_LEFT sub.1 loc_store.SQ_LEFT
        loc_load.SQ_LEFT neq.0
        # => [continue]
    end
    padw loc_loadw_le.SQ_RES
    # => [result_u128]
    exec.safe_cast_u128_into_felt
    # => [felt]
end

#! Floor square root of a felt.
pub proc sqrt(n: felt) -> felt
    # => [felt]
    push.0.0
    # => [0, 0, felt]
    movup.2
    # => [felt, 0, 0]
    u32split
    # => [lo, hi, 0, 0]
    exec.sqrt_u128
    # => [felt]
    exec.sys::truncate_stack
end

#! sqrt(a * b) for two felts. The product is the full 128-bit integer product.
const SP_B = 0
const SP_A = 1
@locals(2)
pub proc sqrt_of_product(b: felt, a: felt) -> felt
    # => [b, a]
    loc_store.SP_B
    # => [a]
    loc_store.SP_A
    # => []
    loc_load.SP_A exec.felt_to_u128
    loc_load.SP_B exec.felt_to_u128
    # => [b_u128, a_u128]
    exec.u128::overflowing_mul
    # => [overflow, product]
    eq.0 assert.err=ERR_OVERFLOW
    # => [product]
    exec.sqrt_u128
    # => [felt]
    exec.sys::truncate_stack
end


@locals(2)
pub proc safe_sub(b: felt, a: felt) -> felt
    # loc.0: a
    # loc.1: res
    swap loc_store.0
    loc_load.0 swap
    sub loc_store.1
    loc_load.1 loc_load.0 
    # [a, res]
    lte assert.err=ERR_UNDERFLOW
    loc_load.1
end

@locals(2)
pub proc safe_add(b: felt, a: felt) -> felt
    # loc.0: b
    # loc.1: res
    loc_store.0
    loc_load.0
    add loc_store.1
    loc_load.1 loc_load.0 
    # [a, res]
    gte assert.err=ERR_OVERFLOW
    loc_load.1
end


#! retuns 0 if equal, 1 if felt_1 smaller, 2 if felt_1 bigger
@locals(2)
pub proc compare_felts(felt_0: felt, felt_1: felt) -> u8
    # loc.0: felt_0
    # loc.1: felt_1
    loc_store.0 loc_store.1
    # => []
    loc_load.1 u32split loc_load.0 u32split exec.u64::lt
    # => [is_felt_0_smaller ]
    if.true # felt_1 smaller
        push.1
    else # if felt_1 is bigger
        loc_load.1 u32split loc_load.0 u32split exec.u64::gt
        # => [is_felt_0_bigger ]
        if.true # felt_0 bigger
            push.2
        else # felt_0 and felt_1 are equal
            push.0
        end
    end

end
